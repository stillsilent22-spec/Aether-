{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Cargo Check Lib",
			"type": "shell",
			"command": "cargo",
			"args": [
				"check",
				"--lib"
			],
			"isBackground": false
		},
		{
			"label": "Run Aether Iced",
			"type": "shell",
			"command": "cargo",
			"args": [
				"run",
				"--bin",
				"aether_iced"
			],
			"isBackground": true
		}
	]
}