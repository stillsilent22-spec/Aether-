{
  "schema": "aether.event.v1",
  "required": [
    "event_id",
    "timestamp",
    "mode",
    "status",
    "data",
    "metrics",
    "errors"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "mode": {
      "type": "string",
      "enum": ["analyze", "guard", "sync", "evolve"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "warning", "critical", "blocked"]
    },
    "data": { "type": "object" },
    "metrics": { "type": "object" },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_action": { "type": "string" },
    "trace_id": { "type": "string" }
  },
  "api_response_contract": {
    "required": ["status", "data", "errors", "metrics"],
    "status_values": ["ok", "warning", "critical", "blocked"]
  }
}
