{
  "schema": "aether.operating_modes.v1",
  "modes": [
    {
      "name": "analyze",
      "description": "Measure structural properties deterministically.",
      "input": ["source", "runtime_context"],
      "gates": ["source_available", "deterministic_path"],
      "outputs": ["metrics", "structural_fingerprint", "summary"],
      "failure_rules": ["missing_source", "invalid_payload", "timeout"]
    },
    {
      "name": "guard",
      "description": "Apply deterministic safety and governance checks.",
      "input": ["metrics", "policy_context"],
      "gates": ["policy_loaded", "boundary_valid"],
      "outputs": ["verdict", "reason", "actions"],
      "failure_rules": ["policy_missing", "unsafe_transition"]
    },
    {
      "name": "sync",
      "description": "Synchronize anchor-compatible outputs without raw data.",
      "input": ["anchor_payload", "transport_context"],
      "gates": ["consent_present", "schema_valid"],
      "outputs": ["pack", "node_report", "sync_status"],
      "failure_rules": ["consent_denied", "schema_error", "transport_error"]
    },
    {
      "name": "evolve",
      "description": "Run bounded deterministic evolution over candidate pools.",
      "input": ["candidate_pool", "state_context"],
      "gates": ["pool_initialized", "rules_loaded"],
      "outputs": ["cycle_summary", "promoted_candidates", "audit"],
      "failure_rules": ["pool_empty", "rule_violation", "cycle_abort"]
    }
  ],
  "run_summary_contract": {
    "required_fields": ["mode", "status", "reason", "metrics", "next_action", "timestamp"],
    "status_values": ["ok", "warning", "critical", "blocked"]
  }
}
