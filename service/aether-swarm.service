[Unit]
Description=Aether Swarm Background Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aether
Group=aether
WorkingDirectory=/opt/aether
ExecStart=/usr/bin/python3 -m modules.swarm_agent
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/aether/data /opt/aether/logs

[Install]
WantedBy=multi-user.target
